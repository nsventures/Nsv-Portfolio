# Copy to .env.local and fill in. Never commit real secrets.
# Full reference: docs/DOCUMENTATION.md §14

# --- Frontend (VITE_* are baked into the build; also set on Vercel) ---
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
# Production only: site protection + admin password gate
VITE_IS_PRODUCTION=false
VITE_ADMIN_GATE_PASSWORD=
# reCAPTCHA v3 (skipped automatically on localhost)
VITE_RECAPTCHA_SITE_KEY=
VITE_SKIP_RECAPTCHA=false
# Bulk import server URL in production (leave blank locally; Vite proxies to :3001)
VITE_BULK_IMPORT_API_URL=

# --- Server-side only (bulk import server, CLI scripts, Vercel runtime) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
IMPORT_PORT=3001
# Optional: reliable YouTube publish dates (also set on Vercel)
YOUTUBE_API_KEY=

# --- Supabase edge function secrets (set in Supabase dashboard, not here) ---
# OTP_HASH_SECRET, ACCESS_TOKEN_SECRET, RESEND_API_KEY, RESEND_FROM_EMAIL,
# CALLBACK_NOTIFY_EMAIL, WHATSAPP_TOKEN, WHATSAPP_PHONE_NUMBER_ID,
# WHATSAPP_TEMPLATE_NAME, RECAPTCHA_SECRET_KEY
